model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Sheet1","Managers_WithStore","Stores"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table Sheet1
ref table Dates
ref table Managers_WithStore
ref table Stores
ref table DimentionSelector
ref table Meaureselector

ref role 'Store Managers'

ref cultureInfo en-US

