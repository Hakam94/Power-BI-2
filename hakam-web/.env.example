# ── Quick start: works today with just a personal PayPal account ──────────
# The account that receives payment via the "classic" redirect checkout —
# no developer app or API keys needed. Already defaults to Hakam's account
# in code, so this is only needed if you want to override it.
VITE_PAYPAL_BUSINESS_EMAIL=h.abushanab94@gmail.com

# ── Optional upgrade: embedded checkout via PayPal's REST Orders API ──────
# Requires a Business account app from https://developer.paypal.com/dashboard.
# When VITE_PAYPAL_CLIENT_ID is set, it takes priority over the classic
# checkout above and payments happen in an on-page widget instead of a
# redirect. See hakam-web/README.md for setup steps.

# Public — bundled into the frontend JS, safe to expose in the browser.
# Must match PAYPAL_CLIENT_ID below (same value, two variables).
VITE_PAYPAL_CLIENT_ID=

# Server-side only — read by the /api serverless functions. NEVER expose the
# secret in frontend code or commit real values to git.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# "sandbox" (default, for testing with fake money) or "live"
PAYPAL_ENV=sandbox
