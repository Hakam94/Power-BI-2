# PayPal REST API credentials — https://developer.paypal.com/dashboard/applications
# Create an app there to get a Client ID + Secret. Use the "Sandbox" app while
# testing, and switch to a "Live" app's credentials when you're ready to accept
# real payments.

# Public — bundled into the frontend JS, safe to expose in the browser.
# This must match PAYPAL_CLIENT_ID below (same value, two variables).
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id

# Server-side only — read by the /api serverless functions. NEVER expose the
# secret in frontend code or commit real values to git.
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# "sandbox" (default, for testing with fake money) or "live"
PAYPAL_ENV=sandbox
