	partition SAP_ACDOCA_Financials = calculated
		mode: import
		source =
				
				VAR _Rev =
				    SELECTCOLUMNS(
				        Sheet1,
				        "Document_Number", "ACD-REV-" & FORMAT(Sheet1[Date], "YYYYMMDD") & "-" & LEFT(Sheet1[Store], 3) & "-" & Sheet1[Drink],
				        "Posting_Date", Sheet1[Date],
				        "Fiscal_Year_Period", FORMAT(Sheet1[Date], "YYYY-MM"),
				        "Company_Code", "CC100 - Hakam Global Coffee",
				        "Store", Sheet1[Store],
				        "Cost_Center", "CC_BAR_01",
				        "GL_Account", "410000",
				        "GL_Account_Name", "Gross Beverage & Food Revenue",
				        "Cost_Category", "Revenue",
				        "Cost_Subcategory", "Revenue",
				        "Amount_USD", Sheet1[Revenue],
				        "Currency", "USD"
				    )
				VAR _Mat =
				    SELECTCOLUMNS(
				        Sheet1,
				        "Document_Number", "ACD-MAT-" & FORMAT(Sheet1[Date], "YYYYMMDD") & "-" & LEFT(Sheet1[Store], 3) & "-" & Sheet1[Drink],
				        "Posting_Date", Sheet1[Date],
				        "Fiscal_Year_Period", FORMAT(Sheet1[Date], "YYYY-MM"),
				        "Company_Code", "CC100 - Hakam Global Coffee",
				        "Store", Sheet1[Store],
				        "Cost_Center", "CC_BAR_01",
				        "GL_Account", "510000",
				        "GL_Account_Name", "Direct Raw Materials (Beans/Dairy/Syrup)",
				        "Cost_Category", "COGS",
				        "Cost_Subcategory", "Direct Materials",
				        "Amount_USD", Sheet1[Cost] * 0.55,
				        "Currency", "USD"
				    )
				VAR _Labor =
				    SELECTCOLUMNS(
				        Sheet1,
				        "Document_Number", "ACD-LAB-" & FORMAT(Sheet1[Date], "YYYYMMDD") & "-" & LEFT(Sheet1[Store], 3) & "-" & Sheet1[Drink],
				        "Posting_Date", Sheet1[Date],
				        "Fiscal_Year_Period", FORMAT(Sheet1[Date], "YYYY-MM"),
				        "Company_Code", "CC100 - Hakam Global Coffee",
				        "Store", Sheet1[Store],
				        "Cost_Center", "CC_BAR_01",
				        "GL_Account", "520000",
				        "GL_Account_Name", "Direct Barista Labor & Payroll",
				        "Cost_Category", "COGS",
				        "Cost_Subcategory", "Direct Labor",
				        "Amount_USD", Sheet1[Cost] * 0.35,
				        "Currency", "USD"
				    )
				VAR _Pack =
				    SELECTCOLUMNS(
				        Sheet1,
				        "Document_Number", "ACD-PCK-" & FORMAT(Sheet1[Date], "YYYYMMDD") & "-" & LEFT(Sheet1[Store], 3) & "-" & Sheet1[Drink],
				        "Posting_Date", Sheet1[Date],
				        "Fiscal_Year_Period", FORMAT(Sheet1[Date], "YYYY-MM"),
				        "Company_Code", "CC100 - Hakam Global Coffee",
				        "Store", Sheet1[Store],
				        "Cost_Center", "CC_BAR_01",
				        "GL_Account", "530000",
				        "GL_Account_Name", "Packaging & Sustainable Cups",
				        "Cost_Category", "COGS",
				        "Cost_Subcategory", "Packaging",
				        "Amount_USD", Sheet1[Cost] * 0.10,
				        "Currency", "USD"
				    )
				VAR _DailyStore =
				    SUMMARIZE(Sheet1, Sheet1[Date], Sheet1[Store])
				VAR _Rent =
				    SELECTCOLUMNS(
				        _DailyStore,
				        "Document_Number", "ACD-RNT-" & FORMAT(Sheet1[Date], "YYYYMMDD") & "-" & LEFT(Sheet1[Store], 3),
				        "Posting_Date", Sheet1[Date],
				        "Fiscal_Year_Period", FORMAT(Sheet1[Date], "YYYY-MM"),
				        "Company_Code", "CC100 - Hakam Global Coffee",
				        "Store", Sheet1[Store],
				        "Cost_Center", "CC_FAC_02",
				        "GL_Account", "610000",
				        "GL_Account_Name", "Store Rent & Facility Lease",
				        "Cost_Category", "OPEX",
				        "Cost_Subcategory", "Rent",
				        "Amount_USD", IF(Sheet1[Store] = "Downtown", 65.0, IF(Sheet1[Store] = "Corporate Park", 55.0, 45.0)),
				        "Currency", "USD"
				    )
				VAR _Util =
				    SELECTCOLUMNS(
				        _DailyStore,
				        "Document_Number", "ACD-UTL-" & FORMAT(Sheet1[Date], "YYYYMMDD") & "-" & LEFT(Sheet1[Store], 3),
				        "Posting_Date", Sheet1[Date],
				        "Fiscal_Year_Period", FORMAT(Sheet1[Date], "YYYY-MM"),
				        "Company_Code", "CC100 - Hakam Global Coffee",
				        "Store", Sheet1[Store],
				        "Cost_Center", "CC_FAC_02",
				        "GL_Account", "620000",
				        "GL_Account_Name", "Utilities (Power/Water/Gas)",
				        "Cost_Category", "OPEX",
				        "Cost_Subcategory", "Utilities",
				        "Amount_USD", IF(Sheet1[Store] = "Downtown", 28.0, IF(Sheet1[Store] = "Corporate Park", 22.0, 18.0)),
				        "Currency", "USD"
				    )
				VAR _Mkt =
				    SELECTCOLUMNS(
				        _DailyStore,
				        "Document_Number", "ACD-MKT-" & FORMAT(Sheet1[Date], "YYYYMMDD") & "-" & LEFT(Sheet1[Store], 3),
				        "Posting_Date", Sheet1[Date],
				        "Fiscal_Year_Period", FORMAT(Sheet1[Date], "YYYY-MM"),
				        "Company_Code", "CC100 - Hakam Global Coffee",
				        "Store", Sheet1[Store],
				        "Cost_Center", "CC_MKT_03",
				        "GL_Account", "640000",
				        "GL_Account_Name", "Digital Marketing & Channel Promo",
				        "Cost_Category", "OPEX",
				        "Cost_Subcategory", "Marketing",
				        "Amount_USD", IF(Sheet1[Store] = "Downtown", 20.0, IF(Sheet1[Store] = "Corporate Park", 16.0, 12.0)),
				        "Currency", "USD"
				    )
				VAR _Adm =
				    SELECTCOLUMNS(
				        _DailyStore,
				        "Document_Number", "ACD-ADM-" & FORMAT(Sheet1[Date], "YYYYMMDD") & "-" & LEFT(Sheet1[Store], 3),
				        "Posting_Date", Sheet1[Date],
				        "Fiscal_Year_Period", FORMAT(Sheet1[Date], "YYYY-MM"),
				        "Company_Code", "CC100 - Hakam Global Coffee",
				        "Store", Sheet1[Store],
				        "Cost_Center", "CC_ADM_04",
				        "GL_Account", "650000",
				        "GL_Account_Name", "Admin & IT Support Overhead",
				        "Cost_Category", "OPEX",
				        "Cost_Subcategory", "Admin",
				        "Amount_USD", IF(Sheet1[Store] = "Downtown", 18.0, IF(Sheet1[Store] = "Corporate Park", 14.0, 10.0)),
				        "Currency", "USD"
				    )
				VAR _Depr =
				    SELECTCOLUMNS(
				        _DailyStore,
				        "Document_Number", "ACD-DEP-" & FORMAT(Sheet1[Date], "YYYYMMDD") & "-" & LEFT(Sheet1[Store], 3),
				        "Posting_Date", Sheet1[Date],
				        "Fiscal_Year_Period", FORMAT(Sheet1[Date], "YYYY-MM"),
				        "Company_Code", "CC100 - Hakam Global Coffee",
				        "Store", Sheet1[Store],
				        "Cost_Center", "CC_FAC_02",
				        "GL_Account", "630000",
				        "GL_Account_Name", "Equipment Depreciation (Espresso/Grinders)",
				        "Cost_Category", "Depreciation",
				        "Cost_Subcategory", "Depreciation",
				        "Amount_USD", IF(Sheet1[Store] = "Downtown", 22.0, IF(Sheet1[Store] = "Corporate Park", 18.0, 15.0)),
				        "Currency", "USD"
				    )
				RETURN
				    UNION(_Rev, _Mat, _Labor, _Pack, _Rent, _Util, _Mkt, _Adm, _Depr)

	annotation PBI_Id = a1b2c3d4e5f64a5b8c7d9e0f1a2b3c4d

