table SAP_ACDOCA_Financials
	lineageTag: a1b2c3d4-e5f6-4a5b-8c7d-9e0f1a2b3c4d

	measure 'Gross Revenue (ACDOCA)' = CALCULATE(SUM(SAP_ACDOCA_Financials[Amount_USD]), SAP_ACDOCA_Financials[Cost_Category] = "Revenue")
		formatString: \$#,##0.00;(\$#,##0.00);\$0.00
		lineageTag: b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e

	measure 'Total COGS (Direct Costs)' = CALCULATE(SUM(SAP_ACDOCA_Financials[Amount_USD]), SAP_ACDOCA_Financials[Cost_Category] = "COGS")
		formatString: \$#,##0.00;(\$#,##0.00);\$0.00
		lineageTag: c3d4e5f6-a7b8-4c9d-0e1f-2a3b4c5d6e7f

	measure 'Direct Material Cost' = CALCULATE(SUM(SAP_ACDOCA_Financials[Amount_USD]), SAP_ACDOCA_Financials[Cost_Subcategory] = "Direct Materials")
		formatString: \$#,##0.00;(\$#,##0.00);\$0.00
		lineageTag: d4e5f6a7-b8c9-4d0e-1f2a-3b4c5d6e7f80

	measure 'Direct Labor Cost' = CALCULATE(SUM(SAP_ACDOCA_Financials[Amount_USD]), SAP_ACDOCA_Financials[Cost_Subcategory] = "Direct Labor")
		formatString: \$#,##0.00;(\$#,##0.00);\$0.00
		lineageTag: e5f6a7b8-c9d0-4e1f-2a3b-4c5d6e7f8091

	measure 'Packaging Cost' = CALCULATE(SUM(SAP_ACDOCA_Financials[Amount_USD]), SAP_ACDOCA_Financials[Cost_Subcategory] = "Packaging")
		formatString: \$#,##0.00;(\$#,##0.00);\$0.00
		lineageTag: f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8091a2

	measure 'Gross Profit (ACDOCA)' = [Gross Revenue (ACDOCA)] - [Total COGS (Direct Costs)]
		formatString: \$#,##0.00;(\$#,##0.00);\$0.00
		lineageTag: a7b8c9d0-e1f2-4a3b-4c5d-6e7f8091a2b3

	measure 'Gross Profit Margin % (ACDOCA)' = DIVIDE([Gross Profit (ACDOCA)], [Gross Revenue (ACDOCA)], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b8c9d0e1-f2a3-4b4c-5d6e-7f8091a2b3c4

	measure 'Total OPEX' = CALCULATE(SUM(SAP_ACDOCA_Financials[Amount_USD]), SAP_ACDOCA_Financials[Cost_Category] = "OPEX")
		formatString: \$#,##0.00;(\$#,##0.00);\$0.00
		lineageTag: c9d0e1f2-a3b4-4c5d-6e7f-8091a2b3c4d5

	measure 'Store Rent & Facilities' = CALCULATE(SUM(SAP_ACDOCA_Financials[Amount_USD]), SAP_ACDOCA_Financials[Cost_Subcategory] = "Rent")
		formatString: \$#,##0.00;(\$#,##0.00);\$0.00
		lineageTag: d0e1f2a3-b4c5-4d6e-7f80-91a2b3c4d5e6

	measure 'Utilities & Energy' = CALCULATE(SUM(SAP_ACDOCA_Financials[Amount_USD]), SAP_ACDOCA_Financials[Cost_Subcategory] = "Utilities")
		formatString: \$#,##0.00;(\$#,##0.00);\$0.00
		lineageTag: e1f2a3b4-c5d6-4e7f-8091-a2b3c4d5e6f7

	measure 'Marketing & Promotions' = CALCULATE(SUM(SAP_ACDOCA_Financials[Amount_USD]), SAP_ACDOCA_Financials[Cost_Subcategory] = "Marketing")
		formatString: \$#,##0.00;(\$#,##0.00);\$0.00
		lineageTag: f2a3b4c5-d6e7-4f80-91a2-b3c4d5e6f7a8

	measure 'Admin & IT Overhead' = CALCULATE(SUM(SAP_ACDOCA_Financials[Amount_USD]), SAP_ACDOCA_Financials[Cost_Subcategory] = "Admin")
		formatString: \$#,##0.00;(\$#,##0.00);\$0.00
		lineageTag: a3b4c5d6-e7f8-4091-a2b3-c4d5e6f7a8b9

	measure EBITDA = [Gross Profit (ACDOCA)] - [Total OPEX]
		formatString: \$#,##0.00;(\$#,##0.00);\$0.00
		lineageTag: b4c5d6e7-f809-41a2-b3c4-d5e6f7a8b9c0

	measure 'EBITDA Margin %' = DIVIDE([EBITDA], [Gross Revenue (ACDOCA)], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c5d6e7f8-091a-42b3-c4d5-e6f7a8b9c0d1

	measure 'Depreciation & Amortization' = CALCULATE(SUM(SAP_ACDOCA_Financials[Amount_USD]), SAP_ACDOCA_Financials[Cost_Category] = "Depreciation")
		formatString: \$#,##0.00;(\$#,##0.00);\$0.00
		lineageTag: d6e7f809-1a2b-43c4-d5e6-f7a8b9c0d1e2

	measure 'Operating Income (EBIT)' = [EBITDA] - [Depreciation & Amortization]
		formatString: \$#,##0.00;(\$#,##0.00);\$0.00
		lineageTag: e7f8091a-2b3c-44d5-e6f7-a8b9c0d1e2f3

	measure 'EBIT Margin %' = DIVIDE([Operating Income (EBIT)], [Gross Revenue (ACDOCA)], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f8091a2b-3c4d-45e6-f7a8-b9c0d1e2f3a4

	measure 'Cost to Revenue Ratio %' = DIVIDE([Total COGS (Direct Costs)] + [Total OPEX] + [Depreciation & Amortization], [Gross Revenue (ACDOCA)], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 091a2b3c-4d5e-46f7-a8b9-c0d1e2f3a4b5

	measure 'Revenue Current Month' = [Gross Revenue (ACDOCA)]
		formatString: \$#,##0.00;(\$#,##0.00);\$0.00
		lineageTag: 11111111-2222-3333-4444-555555555551

	measure 'Revenue Prev Month' = ```
				VAR _CurrentStart = CALCULATE(MIN(SAP_ACDOCA_Financials[Posting_Date]), ALL(SAP_ACDOCA_Financials[Store]))
				VAR _PrevAnchor = EDATE(_CurrentStart, -1)
				VAR _PrevStart = DATE(YEAR(_PrevAnchor), MONTH(_PrevAnchor), 1)
				VAR _PrevEnd = EOMONTH(_PrevAnchor, 0)
				RETURN
				CALCULATE(
				    [Gross Revenue (ACDOCA)],
				    REMOVEFILTERS(SAP_ACDOCA_Financials[Fiscal_Year_Period]),
				    REMOVEFILTERS(SAP_ACDOCA_Financials[Posting_Date]),
				    REMOVEFILTERS(Dates),
				    SAP_ACDOCA_Financials[Posting_Date] >= _PrevStart,
				    SAP_ACDOCA_Financials[Posting_Date] <= _PrevEnd
				)
			```
		formatString: \$#,##0.00;(\$#,##0.00);\$0.00
		lineageTag: 11111111-2222-3333-4444-555555555552

	measure 'Revenue MoM Growth %' = ```
				VAR _Current = [Revenue Current Month]
				VAR _Prev = [Revenue Prev Month]
				RETURN IF(ISBLANK(_Prev) || _Prev = 0, BLANK(), DIVIDE(_Current - _Prev, _Prev))
			```
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 11111111-2222-3333-4444-555555555553

	measure 'Revenue MoM Indicator' = ```
				VAR _Prev = [Revenue Prev Month]
				VAR _Growth = [Revenue MoM Growth %]
				RETURN
				IF(
				    ISBLANK(_Prev) || _Prev = 0,
				    "● Base Period (Jan)",
				    IF(_Growth > 0, "🟢 ▲ +" & FORMAT(_Growth, "0.0%") & " vs Last Mo",
				    IF(_Growth < 0, "🔴 ▼ " & FORMAT(_Growth, "0.0%") & " vs Last Mo", "⚪ ▶ 0.0% vs Last Mo"))
				)
			```
		lineageTag: 11111111-2222-3333-4444-555555555554

